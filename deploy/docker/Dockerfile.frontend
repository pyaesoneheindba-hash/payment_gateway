# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /workspace
COPY frontend/angular-workspace/package.json ./package.json
RUN npm install
COPY frontend/angular-workspace/ ./
RUN npm run build

FROM nginx:1.27-alpine AS checkout-web
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/checkout-web/browser/ /usr/share/nginx/html/

FROM nginx:1.27-alpine AS merchant-portal
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /workspace/dist/merchant-portal/browser/ /usr/share/nginx/html/

FROM nginx:1.27-alpine AS admin-portal
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /workspace/dist/admin-portal/browser/ /usr/share/nginx/html/
