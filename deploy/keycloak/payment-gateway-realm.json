{
  "realm": "payment-gateway",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "payment-admin-portal",
      "name": "Payment Gateway Admin Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4202/*"
      ],
      "webOrigins": [
        "http://localhost:4202"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "payment-portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "payment-portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "payment-merchant-portal",
      "name": "Payment Gateway Merchant Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4201/*"
      ],
      "webOrigins": [
        "http://localhost:4201"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "payment-portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "payment-portal-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "payment-gateway-user-admin",
      "name": "Payment Gateway Merchant User Provisioner",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "${DEV_KEYCLOAK_USER_ADMIN_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "pgadmin",
      "enabled": true,
      "emailVerified": true,
      "email": "pgadmin@local.test",
      "firstName": "Payment",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_PORTAL_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-payment-gateway-user-admin",
      "enabled": true,
      "serviceAccountClientId": "payment-gateway-user-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "loginTheme": "txn-hub",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0
}
