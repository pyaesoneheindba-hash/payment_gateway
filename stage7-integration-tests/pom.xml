<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.paymentgateway</groupId>
		<artifactId>payment-gateway-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>stage7-integration-tests</artifactId>
	<name>Stage 7 isolated payment lifecycle integration tests</name>
	<dependencies>
		<!-- Test-only access to the actual Gateway request-signature filter. -->
		<dependency>
			<groupId>com.paymentgateway</groupId>
			<artifactId>api-gateway</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.paymentgateway</groupId>
			<artifactId>payment-core-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.paymentgateway</groupId>
			<artifactId>notification-service</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<!-- Mockito on JDK 25 needs its agent configured at JVM startup. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>resolve-mockito-agent</id>
						<phase>initialize</phase>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
					<!-- Stage 7 RPC-only tests do not require Dubbo REST
					mapping.
         Avoid loading the incompatible Spring REST extension. -->
					<systemPropertyVariables>
						<dubbo.protocol.triple.rest.enabled>false</dubbo.protocol.triple.rest.enabled>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
