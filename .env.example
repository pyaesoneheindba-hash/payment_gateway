# Payment Gateway local Docker stack
# Copy to .env and fill only the providers you want to exercise.
# Infrastructure addresses, DB credentials, Nacos, Redis and RocketMQ are already
# defined by the docker profile and do not need environment variables.

# Development-only credentials are generated into .env by scripts/dev-stack.* on first start.
# Leave blank in this template; do not commit the generated .env.
DEV_KEYCLOAK_ADMIN_PASSWORD=
DEV_PORTAL_ADMIN_PASSWORD=
DEV_KEYCLOAK_USER_ADMIN_CLIENT_SECRET=

# Browser-visible OIDC URL for Angular portals.
OIDC_BROWSER_BASE_URL=http://localhost:8180
GATEWAY_BROWSER_BASE_URL=http://localhost:8086

# ABank / APlus UAT
ABANK_BASE_URL=https://merchant-thirdparty-api-uat.abdev.net/acquiring-qr-service
ABANK_SECRET_KEY=
ABANK_ECCODE=
ABANK_MERCHANT_ID=

# MPU UAT
MPU_MERCHANT_ID=
MPU_SECRET_KEY=
MPU_CATEGORY_CODE=
# For a real external UAT callback these must be public HTTPS URLs, not localhost.
MPU_FRONTEND_URL=http://localhost:8086/callbacks/mpu/frontend
MPU_BACKEND_URL=http://localhost:8086/callbacks/mpu/backend

# AYA PAY sandbox
AYA_BASE_URL=https://opensandbox.ayainnovation.com
AYA_CONSUMER_KEY=
AYA_CONSUMER_SECRET=
AYA_MERCHANT_PHONE=
AYA_MERCHANT_PASSWORD=
AYA_DECRYPTION_KEY=
AYA_QR_SERVICE_CODE=
AYA_PUSH_SERVICE_CODE=
